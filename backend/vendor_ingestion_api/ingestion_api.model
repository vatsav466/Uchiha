Enum BusinessUnit str {
    RO='RO'
    TAS='TAS'
    LPG='LPG'
    RDI='RDI'
    CP='CP'
}

Enum AlertStatus str {
    Open='Open'
    Close='Close'
    InProgress='InProgress'
    Cancel='Cancel'
    OnHold='OnHold'
}

Model GeoCordinates internal {
    latitude str
    longitude str
}

Model vtsData internal {
    vendor_id str
    location_id str
    location_type str
    tl_number str
    report_duration str
    scheduled_trip_start_datetime optional datetime
    scheduled_trip_end_datetime optional datetime
    total_trips optional int
    stoppage_violations_count optional int
    route_deviation_count optional int
    speed_violation_count optional int
    main_supply_removal_count optional int
    night_driving_count optional int
    no_halt_zone_count optional int
    device_offline_count optional int
    device_tamper_count optional int
    continuous_driving_count optional int
    approved_by optional str
    invoice_number optional str
    tt_type optional str
    data_reprocessed optional bool
    destination_code optional str
    destination_name optional str
}

Model VtsEventData internal {
    vendor_id str
    location_id str
    location_type str
    tt_number str
    event_id str
    report_duration optional str    
    event_start_time optional datetime
    event_end_time optional datetime  
    event_start_location optional str
    event_end_location optional str  
    coordinates optional GeoCordinates
    distance optional str
    total_trips optional int
    stoppage_violations_count optional int
    route_deviation_count optional int
    speed_violation_count optional int
    main_supply_removal_count optional int
    night_driving_count optional int
    no_halt_zone_count optional int
    device_offline_count optional int
    device_tamper_count optional int
    continuous_driving_count optional int
    approved_by optional str
    invoice_number optional str
    tt_type optional str
    transporter optional str
    data_reprocessed optional bool
    is_valid optional bool
    unique_id optional int
    alert optional str
}

Model VtsTripData internal {
    vendor_id str
    location_id str
    location_type str
    tt_number str
    trip_start_time optional datetime
    trip_end_time optional datetime
    distance optional str
    tt_type optional str
    invoice_number optional str
    transporter optional str
}

Model vtsDataUpdated internal {
    alert_id str
    zone optional str
    location_name optional str
    terminal_code optional str
    trip_status optional str
    truck_regno str
    violation_type str
    threshold_limit optional str
    unit optional str
    min_violation_count optional str
    max_violation_count optional str
    trip_alert_count optional str
    violation_count optional str
    shortage_in_trip optional str
    cumulative_duration optional str
    trip_type optional str
    active optional str
    approval_status optional str
    start_location optional str
    end_location optional str
    distance optional str
    duration optional str
    from_date optional str
    to_date optional str
    latitude optional str
    longitude optional str
    endlatitude optional str
    endlongitude optional str
}

Model vtsBlockedTruckOld internal {
    alert_id str
    alert_type str
    action_type optional str
    category optional str
    rca_reason optional str
    remarks optional str
    truck_regno optional str
    without_shortage_count optional str
    with_shortage_count optional str
    first_blocked_days optional str
    second_blocked_days optional str
    third_blocked_days optional str
    active optional bool
    approval_status optional str
    blocked_datetime optional str
    unblocked_datetime optional str
}

Model VtsTripNotClosed internal {
    violation_type optional str
    event_date optional datetime
    zone optional str
    location_code optional str
    destination_code optional str
    location_type optional str
    tt_type optional str
    tt_number optional str
    transporter_id optional str
    transporter_name optional str
    invoice_no optional str
    trip_id optional str
    load_no optional str
    route_no optional str
    driver_name optional str
    scheduled_datetime optional datetime
    scheduled_end_datetime optional datetime
    vehicle_latitude optional float
    vehicle_longitude optional float
    vehicle_location optional str
    
}

Model VtsTripWithoutRoute internal {
    violation_type optional str
    event_date optional datetime
