Model VtsUnauthStoppage internal {

    violation_type optional str
    event_date optional datetime
    zone optional str
    location_code optional str
    destination_code optional str
    location_type optional str
    tt_type optional str
    tt_number optional str
    transporter_id optional str
    transporter_name optional str
    invoice_no optional str
    trip_id optional str
    load_no optional str
    driver_name optional str
    scheduled_datetime optional datetime
    vehicle_latitude optional float
    vehicle_longitude optional float
    vehicle_location optional str

}

Model vtsBlockedTruck internal {
    tt_no optional str
    location_name optional str
    transporter_name optional str
    transporter_code optional str
    vehicle_blocked_desc optional str
    vehicle_blocked_start_date optional str
    vehicle_blocked_end_date optional str
    vehicle_blocked_instance_no optional str
    vehicle_blocked_instance_type optional str
    alert_type optional str
}

Model OngoingTripsVts crud_disable {
     Action=> trip_not_closed {
        data list VtsTripNotClosed
    }

    Action=> trip_without_route {
        data list VtsTripWithoutRoute
    }

    Action=> route_deviation_more_than_two_km {
        data list VtsRouteTwoKm
    }

    Action=> trip_unauthorised_stoppage {
        data list VtsUnauthStoppage
    }
}

Model VTS crud_disable {
    Action=> ingest_data {
        data list vtsData
    }
    Action=> ingest_event_data {
        data list VtsEventData
    }
    Action=> ingest_trip_data {
        data list VtsEventData
    }

    Action=> ingest_data_blocked_trucks {
        vendor_id str
        location_id str
        location_type optional BusinessUnit
        data list vtsBlockedTruck
    }

    Action=> ingest_data_un_blocked_trucks {
        vendor_id str
        location_id str
        location_type optional BusinessUnit
        data list vtsBlockedTruck

    }   
    
}

Model vaData internal {
    alert_id optional str
    alert_timestamp optional str
    alert_type str
    alert_description optional str
    device_id str
    video_url optional str
}

Model vaScore internal {
    overall_score optional str
}

Model VA_RO_Cleanliness_Master internal {
    ROCode str
    ROName optional str
    Zone optional str
    Region optional str
    SalesArea optional str
}

Model VA_RO_Cleanliness_Master_Status internal {
    ROCode str
    ROName optional str
    Zone optional str
    Region optional str
    SalesArea optional str
    UploadDone bool
}

Model VA crud_disable {
    Action=> ingest_data {
        vendor_id str
        location_id str
        location_type optional BusinessUnit
        data optional list vaData
    }

    Action=> ingest_data_score {
        vendor_id str
        location_id str
        location_type optional BusinessUnit
        data list vaScore
    }

    Action=> ingest_data_close {
        alert_id str
        status str
        acknowledged_by str
        closed_at str
        action_description optional str
        action_code optional str
        action_reason optional str
        action_category optional str
    }

    Action=> ro_no_video_upload_list {
        data list VA_RO_Cleanliness_Master
    }

    Action=> ro_no_video_upload_list_status {
        data list VA_RO_Cleanliness_Master_Status
    }
}

Model productsDetails internal {
    prod_code optional str
    uom optional str
    qty optional str
}

Model crisData internal {
    interlock_type str
    interlock_description optional str
    device_name str
    device_id optional str
    severity optional str
    alarm_id str
    tank_id optional str
    nozzle_id optional str
    pump_no optional str
    occurrence_date optional str
    closure_date optional str
    indent_no optional str
    products optional list productsDetails
}

Model CRIS crud_disable {
    Action=> ingest_data {
        vendor_name str
        vendor_id str
        location_id str
        ro_code str
        location_type optional BusinessUnit
        data optional list crisData
    }

    Action=> api_ack {
        req_no str
        applied_on str
    }

}

Model IMS crud_disable {
    Action=> ingest_data {
        vendor_id str
        location_id str
        location_type optional BusinessUnit
    }
}

Model emlockData internal {
    location_id str
    location_type optional BusinessUnit
    vehicle_number str
    violation_type str
    initiated_date str
    approved_date optional str
    approved_by optional str
}

Model emlockVendorData internal {
    location_type str
    emlock_exception_id str
    terminal_code str
    truck_number str
    exception_type str
    ro_code optional str
    created_datetime str
}

Model EMLock crud_disable {
    Action=> ingest_data {
        vendor_id str
        data optional list emlockVendorData
    }
}

Model TasListener crud_disable {
    Action=> get_data {
        input_data dict
    }
}


Model TasAgentCommStatus {

    sap_id  str
    status optional str
    message optional str
    opcda_status optional str
    data_receiving_status optional str
    configuration_healthy optional str
    last_opc_failure optional str
    last_rabbit_failure optional str
    location_name optional str

}


Model TAS_Location_Listener crud_disable {
    Action=> get_agent_service_status {
        sap_id  str
        status optional str
        message optional str
    }

    Action=> get_agent_comm_status {
        sap_id  str
        status optional str
        message optional str
        opcda_status optional str
        data_receiving_status optional str
        configuration_healthy optional str
        last_opc_failure optional str
        last_rabbit_failure optional str
        
    }
}

Model emlockStatusData internal {
    event_id str
    vendor_id str
    location_type str
    emlock_exception_id optional str
    terminal_code optional str
    truck_number optional str
    swipein_l1 optional bool
    swipein_l2 optional bool
    swipeout_l1 optional bool
    swipeout_l2 optional bool
    l1_id optional str
    l2_id optional str
    created_date optional datetime
    invoice_number optional str
}

Model EMLockStatus crud_disable {
    Action=> ingest_data {
        vendor_id str
        event_id str
        data optional list emlockStatusData
    }
}

Model HyperLocalZoneSummary internal {
    zone str
    rating float
}

Model ReviewsSentiment internal {
    zone str
    sales_area str
    region str
    store_code str
    store_name str
    reviewer_name str
    rating float
    review_comment str
    tone_type str
    review_date datetime
    rank int
}

Model HyperLocal crud_disable {
    Action=> ingest_data {
        report_date date
        total_reviews int
        positive_reviews int
        negative_reviews int
        neutral_reviews int
        zone_summary list HyperLocalZoneSummary
        sentiment_of_reviews list ReviewsSentiment
    }
}