# ── Password encryption salt (CRITICAL for login) ─────────────────────────────
# Passwords in the `users` table are stored as Fernet tokens derived via HKDF
# from this salt. It MUST match the salt that was used when the passwords were
# created. If this DB was migrated from an older deployment that used a
# different salt, login fails with 401 "Invalid Login Credentials" for every
# user. In that case either:
#   1) set this to the ORIGINAL salt from the old deployment, or
#   2) reset the passwords with the current salt:
#        docker exec novex_dev /opt/venv/bin/python \
#          /opt/ceg/algo/api_manager/reset_password.py admin '<NewPassword>'
password_salt=urdhva_base_secret

